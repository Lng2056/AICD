; metal7_conn=(Metal7 andnot Metal7_slot) andnot M7Resdum
L92001=geomAndNot(Metal7 Metal7_slot)
metal7_conn=geomAndNot(L92001 M7Resdum)

; Metal8_d_n=if MergePinAndNet Metal8_d or Metal8_n else Metal8_d
