; metal8_conn=(Metal8 andnot Metal8_slot) andnot M8Resdum
L18145=geomAndNot(Metal8 Metal8_slot)
metal8_conn=geomAndNot(L18145 M8Resdum)

; Metal9_d_n=if MergePinAndNet Metal9_d or Metal9_n else Metal9_d
ivIf( switch("MergePinAndNet") then
    Metal9_d_n=geomOr(Metal9_d Metal9_n)
else
    Metal9_d_n=Metal9_d
)


; Metal9=Metal9_d_n or Metal9_p
Metal9=geomOr(Metal9_d_n Metal9_p)

; metal9_conn=(Metal9 andnot Metal9_slot) andnot M9Resdum
L44289=geomAndNot(Metal9 Metal9_slot)
metal9_conn=geomAndNot(L44289 M9Resdum)

; metal1_with_diode=(metal1_conn interact > 1 diff_diode) or (metal1_conn interact
;  (diff_diode area >= 0.1))
L90713=geomButtOrOver(metal1_conn diff_diode keep>1)
L28904=drc(diff_diode area>=0.1)
L77036=geomButtOrOver(metal1_conn L28904)
metal1_with_diode=geomOr(L77036 L90713)

; metal1_wo_diode=metal1_conn andnot metal1_with_diode
metal1_wo_diode=geomAndNot(metal1_conn metal1_with_diode)


