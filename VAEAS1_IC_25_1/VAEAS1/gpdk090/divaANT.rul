        via(Via3 metal4_conn metal3_conn)
        via(Via2 metal3_conn metal2_conn)
        via(Via1 metal2_conn metal1_with_diode)
        via(cont_poly metal1_with_diode Poly)
        via(cont_diode metal1_with_diode diff_diode)
    )

    gate=geomStamp(gate Poly)
    drcAntenna(
        var1=area(gate)
        create(antError33 var1 && (((area(Via1)+area(Via2)+area(Via3))/if(var1
            var1 1))-((area(diff_diode)*250.0)+1000.0))>0.0 metal4_conn)
    )
    saveDerived(antError33
        "ANT.8.V1_3: Cumulative Via1 through Via3 area to gate area ratio must be <= 1000 + (diode area * 250)")

)

