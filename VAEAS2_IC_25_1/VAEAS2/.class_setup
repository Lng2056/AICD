#! /bin/csh
########################################################################
# Course:    VAEAS2: ADE Assembler and Multi Test Corner Analysis 
# Filename:  .class_setup
########################################################################
#
# This file assumes that the Cadence Suite of products are in the
# hierarchy /cds.
#
# If the Cadence products are installed elsewhere, change the
# variable CDS to point to the correct path.
#

#! /bin/csh
# This sets the netlisting mode to analog
setenv CDS_Netlisting_Mode Analog
#setenv LD_ASSUME_KERNEL 2.4.1
setenv LANG en_US
# These unset any environment variables that have been previously set
unsetenv CDSHOME
unsetenv SPECTREHOME
#unsetenv USIM_ROOT
#unsetenv USIM_HOME
# These environment variables can be added to the user cshrc file
# Put in the correct path names to the software installs
setenv CDSHOME /ccstools/cdsind1/Software/IC251Base_lnx86
setenv SPECTREHOME /ccstools/cdsind1/Software/SPECTRE241ISR6_lnx86
#setenv USIM_ROOT $SPECTREHOME/tools
#setenv CDSDIR $CDSHOME/tools/dfII
# These lines set up the paths needed for the course
#setenv LD_LIBRARY_PATH ${CDSHOME}/tools/lib:${SPECTREHOME}/tools/ultrasim/lib:${LDVHOME}/tools/inca/lib:${LDVHOME}/tools/lib
set path=($path ${CDSHOME}/tools/dfII/bin ${CDSHOME}/tools/bin )
set path=($path ${SPECTREHOME}/tools/bin )
#setenv SPECTRE_DEFAULTS "+l %C:r.out -f psfbin"
#set PLATFORM = `uname -s`
#if("$PLATFORM" == "SunOS") then   
#  setenv CDS_AHDLCMI_ENABLE NO
#endif
rehash
