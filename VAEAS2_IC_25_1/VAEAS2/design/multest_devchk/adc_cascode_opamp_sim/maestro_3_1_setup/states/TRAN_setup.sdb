				<vars>
					<var>siddq
						<value>1.0</value>
					</var>
					<var>vdd
						<value>2.5</value>
					</var>
					<var>vin_ac
						<value>1.0</value>
					</var>
				</vars>
				<outputs>
					<output>AvgOut
						<evalType>point</evalType>
					</output>
					<output>average(VT("/Vout2"))
						<evalType>point</evalType>
					</output>
				</outputs>
			</test>
