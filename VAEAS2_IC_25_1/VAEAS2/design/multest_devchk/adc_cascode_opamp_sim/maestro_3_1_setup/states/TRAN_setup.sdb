					</option>
					<option>lib
						<value>multest_devchk</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>sch_dc_ac_2</value>
					</option>
				</origoptions>
			</test>
			<test enabled="1">TRAN_test
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>adc_cascode_opamp_sim</value>
					</option>
					<option>lib
						<value>multest_devchk</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>sch_Gain_Vio_CMRR_SR</value>
