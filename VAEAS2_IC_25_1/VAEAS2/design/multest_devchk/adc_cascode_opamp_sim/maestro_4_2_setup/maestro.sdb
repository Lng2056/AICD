<?xml version="1.0"?>
<setupdb version="7">maestro
	<active>Active Setup
		<corners>
			<corner enabled="1">_default</corner>
		</corners>
		<extensions>
			<extension>Parasitics
				<callback>_parSetupDBExtensionCB</callback>
				<iconvalue></iconvalue>
				<icontype></icontype>
			</extension>
		</extensions>
		<currentmode>Single Run, Sweeps and Corners</currentmode>
		<overwritehistory>0</overwritehistory>
		<tests>
			<test>AC_test
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>adc_cascode_opamp_sim</value>
					</option>
					<option>lib
						<value>multest_devchk</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>sch_dc_ac_2</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR</value>
					</option>
					<option>state
						<value>active</value>
					</option>
				</tooloptions>
				<vars>
					<var>siddq
						<value>0</value>
					</var>
					<var>vdd
						<value>2.5</value>
					</var>
					<var>vin_ac
						<value>0.5 1.0 1.5</value>
					</var>
					<var>temperature
						<value>27</value>
					</var>
				</vars>
				<outputs>
					<output>/OUT_AC_3BIT
						<evalType>point</evalType>
					</output>
					<output>AC_gain_1k
						<evalType>point</evalType>
					</output>
					<output>AC_BW_3dB
						<evalType>point</evalType>
					</output>
				</outputs>
				<origoptions>
					<option>cell
						<value>adc_cascode_opamp_sim</value>
					</option>
					<option>lib
						<value>multest_devchk</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>sch_dc_ac_2</value>
					</option>
				</origoptions>
			</test>
			<test enabled="1">TRAN_test
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>adc_cascode_opamp_sim</value>
					</option>
					<option>lib
						<value>multest_devchk</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>sch_Gain_Vio_CMRR_SR</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR</value>
					</option>
					<option>state
						<value>active</value>
					</option>
				</tooloptions>
				<vars>
					<var>siddq
						<value>1.0</value>
					</var>
					<var>vdd
						<value>2.5</value>
					</var>
					<var>vin_ac
						<value>1.0</value>
					</var>
				</vars>
				<outputs>
					<output>/Vout2
						<evalType>point</evalType>
					</output>
					<output>AvgOut
						<evalType>point</evalType>
					</output>
				</outputs>
				<origoptions>
					<option>cell
						<value>adc_cascode_opamp_sim</value>
					</option>
					<option>lib
						<value>multest_devchk</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>sch_Gain_Vio_CMRR_SR</value>
					</option>
				</origoptions>
			</test>
		</tests>
		<checksasserts netlist="0">
			<test netlist="0" netlistscope="all">multest_devchk:adc_cascode_opamp_sim:1</test>
		</checksasserts>
		<plottingoptions>
			<plottingoption>plottype
				<value>Auto</value>
			</plottingoption>
			<plottingoption>autoplotsignals
				<value>yes</value>
			</plottingoption>
			<plottingoption>autoplotwaveexpr
				<value>yes</value>
			</plottingoption>
			<plottingoption>autoplotscalarexpr
				<value>yes</value>
			</plottingoption>
			<plottingoption>autoplotmode
				<value>Append</value>
			</plottingoption>
			<plottingoption>annotatedesignname
				<value>yes</value>
			</plottingoption>
			<plottingoption>annotatesimdate
				<value>yes</value>
			</plottingoption>
			<plottingoption>annotatetemperature
				<value>no</value>
			</plottingoption>
			<plottingoption>annotatedesignvars
				<value>no</value>
			</plottingoption>
			<plottingoption>annotatescalaroutputs
				<value>no</value>
			</plottingoption>
			<plottingoption>annotatespecmarkers
				<value>no</value>
			</plottingoption>
			<plottingoption>histogramtype
				<value>pass/fail</value>
			</plottingoption>
			<plottingoption>histogrambins
				<value>10</value>
			</plottingoption>
			<plottingoption>showhistogramdensity
				<value>yes</value>
			</plottingoption>
			<plottingoption>showhistogramdeviation
				<value>yes</value>
			</plottingoption>
			<plottingoption>showhistogrampercentmarkers
				<value>no</value>
			</plottingoption>
			<plottingoption>histogramqqplot
				<value>no</value>
			</plottingoption>
			<plottingoption>showhistogrampoints
				<value>yes</value>
			</plottingoption>
			<plottingoption>directplotmode
				<value>New SubWin</value>
			</plottingoption>
			<plottingoption>directplotafter
				<value>All Selections Are Made</value>
			</plottingoption>
			<plottingoption>printafter
				<value>Each Selection</value>
			</plottingoption>
			<plottingoption>usewaveformtemplate
				<value>no</value>
			</plottingoption>
			<plottingoption>waveformtemplate
				<value></value>
			</plottingoption>
			<plottingoption>plottingmode
				<value>Replace</value>
			</plottingoption>
			<plottingoption>useMaestroPlottingTemplate
				<value>yes</value>
			</plottingoption>
			<plottingoption>allplottingtemplates
				<value></value>
			</plottingoption>
			<plottingoption>defaultplottingtemplate
				<value></value>
			</plottingoption>
			<plottingoption>distributedplot_enabled
				<value>no</value>
			</plottingoption>
			<plottingoption>additionalcalcs
				<value>yes</value>
			</plottingoption>
			<plottingoption>exactmatchonly
				<value>no</value>
			</plottingoption>
			<plottingoption>createnewstrips
				<value>no</value>
			</plottingoption>
			<plottingoption>usecolorbank
				<value>no</value>
			</plottingoption>
			<plottingoption>quickplotenable
				<value>yes</value>
			</plottingoption>
			<plottingoption>useExpressionDB
				<value>no</value>
			</plottingoption>
			<plottingoption>probingmode
				<value>current</value>
			</plottingoption>
			<plottingoption>distributedplot_linger_time
				<value>60</value>
			</plottingoption>
		</plottingoptions>
		<overwritehistoryname>Interactive.0</overwritehistoryname>
		<vars>
			<var enabled="1">siddq
				<value>0</value>
				<dependentTests>
					<dependentTest enabled="1">AC_test</dependentTest>
					<dependentTest omitted="0">TRAN_test</dependentTest>
				</dependentTests>
			</var>
			<var enabled="1">vdd
				<value>2.5</value>
				<dependentTests>
					<dependentTest enabled="1">AC_test</dependentTest>
					<dependentTest omitted="0">TRAN_test</dependentTest>
				</dependentTests>
			</var>
			<var enabled="0">vin_ac
				<value>1.0</value>
				<dependentTests>
					<dependentTest enabled="0">AC_test</dependentTest>
					<dependentTest omitted="0">TRAN_test</dependentTest>
				</dependentTests>
			</var>
		</vars>
		<disabledtests>
			<test>TRAN_test</test>
		</disabledtests>
		<specs>
			<spec>AC_test.AC_gain_1k
				<testname>AC_test</testname>
				<resname>AC_gain_1k</resname>
				<specType>tol</specType>
				<min></min>
				<max></max>
				<target>115</target>
				<tol>1</tol>
				<tolType>%</tolType>
			</spec>
			<spec>AC_test.AC_BW_3dB
				<testname>AC_test</testname>
				<resname>AC_BW_3dB</resname>
				<specType>gt</specType>
				<min>36M</min>
				<max></max>
				<target></target>
				<tol></tol>
			</spec>
		</specs>
		<outputscustomcols>
			<customcol>Comments
				<outputs>
					<output>AC_test.AC_BW_3dB
						<value>This is the 3dB bandwidth</value>
						<testname>AC_test</testname>
						<resname>AC_BW_3dB</resname>
					</output>
				</outputs>
			</customcol>
		</outputscustomcols>
		<sharedvarinfo></sharedvarinfo>
		<incrementalsimulationoptions>
			<incrementalSimulation>0</incrementalSimulation>
		</incrementalsimulationoptions>
		<saveoptions>
			<rdboption>default</rdboption>
			<psfoption>default</psfoption>
		</saveoptions>
	</active>
	<history>History
	</history>
</setupdb>
