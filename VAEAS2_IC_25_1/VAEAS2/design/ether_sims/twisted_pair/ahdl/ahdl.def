// Spectre AHDL for impala, twisted_pair, ahdl
// Twisted pair model for cat3 and cat5 cable
// 7 poles, 2 zeros fitted to root f cable
//
// alpha = 1.51e-6 for cat 3
// alpha = 9.76e-7 for cat5

module twisted_pair ( out_neg, out_pos, in_neg, in_pos) (L, alpha)
    node [V,I] out_neg;
    node [V,I] out_pos;
    node [V,I] in_neg;
    node [V,I] in_pos;
    
 parameter real L = 100;  
 parameter real alpha = 9.76e-7;
    
{

const real pi = 3.14159265;
real L0 = 100;
real alpha0 = 1.51e-6;
real zeros[4];
real poles[14];


initial
 {
 
zeros[0] = -2*pi*0.23844e6*pow((alpha0*L0)/(alpha*L),2);
zeros[1] = 0;
zeros[2] = -2*pi*3.6857e6*pow((alpha0*L0)/(alpha*L),2);
zeros[3] =0;

poles[0] = -2*pi*0.17539e6*pow((alpha0*L0)/(alpha*L),2);
poles[1] = 0;
poles[2] = -2*pi*2.0514e6*pow((alpha0*L0)/(alpha*L),2);
poles[3] = 0;
poles[4] = -2*pi*10.458e6*pow((alpha0*L0)/(alpha*L),2);
poles[5] = 0;
poles[6] = -2*pi*77.657e6*pow((alpha0*L0)/(alpha*L),2);
poles[7] = 0;
poles[8] = -2*pi*323.76e6*pow((alpha0*L0)/(alpha*L),2);
poles[9] = 0;
poles[10] = -2*pi*323.76e6*pow((alpha0*L0)/(alpha*L),2);
poles[11] = 0;
poles[12] = -2*pi*323.76e6*pow((alpha0*L0)/(alpha*L),2);
poles[13] = 0;

}
 
analog
 {


V(out_pos) <- $laplace_zp(V(in_pos), zeros, poles);
 
V(out_neg) <- $laplace_zp(V(in_neg), zeros, poles);
}

}
