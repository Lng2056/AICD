	V(CLKFB)<+transition(fun_CLKFB?(global_VDD_value/2):0,(CLKFB_t1<0)?0:CLKFB_t1,((CLKFB_delay-CLKFB_t1)>0)?CLKFB_delay-CLKFB_t1:1e-12);
	V(CLKFB)<+transition(fun_CLKFB?(global_VDD_value/2):0,(CLKFB_delay<0)?0:CLKFB_delay,((CLKFB_t2-CLKFB_delay)>0)?CLKFB_t2-CLKFB_delay:1e-12);
	V(CLKFB) <+ I(CLKFB) * 0.1;
