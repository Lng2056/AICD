				fun_CLKFB=1;
				CLKFB_t1=$table_model(global_VDD_value,"PLL_250MHZ_MDIV_rise_CLKVCO_CLKFB_t1.vat","");
				CLKFB_delay=$table_model(global_VDD_value,"PLL_250MHZ_MDIV_rise_CLKVCO_CLKFB_delay.vat","");
				CLKFB_t2=$table_model(global_VDD_value,"PLL_250MHZ_MDIV_rise_CLKVCO_CLKFB_t2.vat","");
			end else if (count_CLKFB==10) begin
				fun_CLKFB=0;
				CLKFB_t1=$table_model(global_VDD_value,"PLL_250MHZ_MDIV_fall_CLKVCO_CLKFB_t1.vat","");
				CLKFB_delay=$table_model(global_VDD_value,"PLL_250MHZ_MDIV_fall_CLKVCO_CLKFB_delay.vat","");
				CLKFB_t2=$table_model(global_VDD_value,"PLL_250MHZ_MDIV_fall_CLKVCO_CLKFB_t2.vat","");
